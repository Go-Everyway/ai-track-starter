# Copy to .env and fill in. .env is gitignored: never commit a key.

# "openai-compatible" talks to a real provider. "mock" needs no key and costs nothing.
LLM_PROVIDER=mock

# The worked default is OpenRouter. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Model ids change often. Pick current ones from your provider's model list.
LLM_MODEL=
EMBED_MODEL=

# lib/llm.py refuses calls once today's logged spend reaches this.
LLM_DAILY_BUDGET_USD=1.00

# Only needed if your provider doesn't report cost per call:
# LLM_PRICES={"your-model-id": [input_usd_per_million, output_usd_per_million]}
